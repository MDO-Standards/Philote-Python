[run]
source = philote_mdo

[report]
# Fail if total coverage drops below 95%
fail_under = 95

# Exclude generated protobuf files from coverage reports
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

omit = 
    philote_mdo/generated/*
    philote_mdo/__init__.py
    philote_mdo/*/__init__.py
    tests/*

[html]
directory = htmlcov
omit = 
    philote_mdo/generated/*
    philote_mdo/__init__.py
    philote_mdo/*/__init__.py
    tests/*
